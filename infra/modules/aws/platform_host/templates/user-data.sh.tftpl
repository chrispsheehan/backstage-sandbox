#!/usr/bin/env bash
set -euo pipefail

exec > >(tee /var/log/platform-bootstrap.log | logger -t platform-bootstrap -s 2>/dev/console) 2>&1

AWS_REGION="${aws_region}"
# Replacing the host when copied repo content changes is intentional for this disposable PoC.
PLATFORM_REPO_CONTENT_HASH="${platform_repo_content_hash}"
# Replacing it after a Backstage OAuth rotation refreshes the in-cluster Secret.
BACKSTAGE_AUTH_REVISION="${backstage_auth_revision}"

# Session Manager becoming Online is the signal that the complete lab is ready.
systemctl stop amazon-ssm-agent

# Restore diagnostic access if a later bootstrap step fails under `set -e`.
restart_ssm_agent_on_exit() {
  exit_code="$?"
  if (( exit_code != 0 )); then
    echo "Platform bootstrap failed with exit code $exit_code."
  fi
  systemctl restart amazon-ssm-agent || true
}
trap restart_ssm_agent_on_exit EXIT

dnf install -y docker gzip tar unzip
systemctl enable --now docker
usermod -aG docker ec2-user

printf '%s' "${bootstrap_script_base64gzip}" | base64 --decode | gzip --decompress >/usr/local/sbin/bootstrap-platform-host
chmod 0755 /usr/local/sbin/bootstrap-platform-host

install -d -m 0755 /opt/backstage-sandbox
until aws s3 cp "${platform_repo_s3_uri}" /tmp/platform-repo.zip --region "$AWS_REGION"; do
  sleep 10
done
unzip -q /tmp/platform-repo.zip -d /opt/backstage-sandbox
chmod 0755 /opt/backstage-sandbox/scripts/lab/*.sh
chown -R ec2-user:ec2-user /opt/backstage-sandbox

export AWS_REGION PLATFORM_REPO_CONTENT_HASH BACKSTAGE_AUTH_REVISION
/usr/local/sbin/bootstrap-platform-host
sudo -iu ec2-user env ARGOCD_HTTPS_HOST_PORT=8443 BACKSTAGE_HTTP_HOST_PORT=80 \
  /opt/backstage-sandbox/scripts/lab/bootstrap-cluster.sh
sudo -iu ec2-user /opt/backstage-sandbox/scripts/lab/configure-ec2-argocd-github-auth.sh \
  "$AWS_REGION" "${backstage_parameter_prefix}" "${argocd_url}"
sudo -iu ec2-user /opt/backstage-sandbox/scripts/lab/install-crossplane-providers.sh ec2
sudo -iu ec2-user /opt/backstage-sandbox/scripts/lab/configure-ec2-backstage-secrets.sh \
  "$AWS_REGION" "${ecr_repository_url}" "${backstage_parameter_prefix}"
sudo -iu ec2-user /opt/backstage-sandbox/scripts/lab/deploy-ec2-argocd-apps.sh \
  "${git_repository_url}" "${git_revision}"
systemctl restart amazon-ssm-agent
trap - EXIT

echo "Platform bootstrap completed."
