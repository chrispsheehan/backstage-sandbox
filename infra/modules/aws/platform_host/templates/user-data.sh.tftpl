#!/usr/bin/env bash
set -euo pipefail

exec > >(tee /var/log/platform-bootstrap.log | logger -t platform-bootstrap -s 2>/dev/console) 2>&1

# Keep informational CNI bridge messages in the kernel log without flooding
# the EC2 serial console followed by `just bootstrap-logs`.
dmesg --console-level warn

AWS_REGION="${aws_region}"
# These markers deliberately replace this disposable host when its packaged
# repo content or runtime configuration changes.
# Platform repo content: ${platform_repo_content_hash}
# Backstage runtime revision: ${backstage_runtime_revision}

# Session Manager becoming Online is the signal that the complete lab is ready.
systemctl stop amazon-ssm-agent

# Restore diagnostic access if a later bootstrap step fails under `set -e`.
restart_ssm_agent_on_exit() {
  exit_code="$?"
  if (( exit_code != 0 )); then
    echo "Platform bootstrap failed with exit code $exit_code."
  fi
  systemctl restart amazon-ssm-agent || true
}
trap restart_ssm_agent_on_exit EXIT

dnf install -y unzip
install -d -m 0755 /opt/backstage-sandbox
until aws s3 cp "${platform_repo_s3_uri}" /tmp/platform-repo.zip --region "$AWS_REGION"; do
  sleep 10
done
unzip -q /tmp/platform-repo.zip -d /opt/backstage-sandbox
chmod 0755 /opt/backstage-sandbox/scripts/aws/*.sh
chmod 0755 /opt/backstage-sandbox/scripts/lab/*.sh
chown -R ec2-user:ec2-user /opt/backstage-sandbox

install -d -m 0755 /etc/backstage-sandbox
printf '%s' "${bootstrap_environment_base64}" | base64 --decode \
  >/etc/backstage-sandbox/platform-bootstrap.env
chmod 0600 /etc/backstage-sandbox/platform-bootstrap.env

/opt/backstage-sandbox/scripts/aws/platform-bootstrap.sh all

systemctl restart amazon-ssm-agent
trap - EXIT

echo "Platform bootstrap completed."
