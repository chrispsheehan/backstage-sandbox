CI_PROJECT_DIR := source_directory() / "../.."

# Run one Terragrunt operation for a dev AWS stack, for example:
# just tg dev aws/platform_host plan
tg env module op:
    #!/usr/bin/env bash
    set -euo pipefail
    if [[ -f "{{ CI_PROJECT_DIR }}/.env" ]]; then
        set -a
        source "{{ CI_PROJECT_DIR }}/.env"
        set +a
    fi
    if [[ -n "${AUTH_GITHUB_CLIENT_ID:-}" && -n "${AUTH_GITHUB_CLIENT_SECRET:-}" ]]; then
        export TF_VAR_backstage_github_client_id="${AUTH_GITHUB_CLIENT_ID}"
        export TF_VAR_backstage_github_client_secret="${AUTH_GITHUB_CLIENT_SECRET}"
    fi
    if [[ -z "${AWS_ACCOUNT_ID:-}" ]]; then
        AWS_ACCOUNT_ID="$(aws sts get-caller-identity --query Account --output text)"
        export AWS_ACCOUNT_ID
    fi
    export TG_NON_INTERACTIVE=true
    terragrunt \
      --working-dir "{{ CI_PROJECT_DIR }}/infra/live/{{ env }}/{{ module }}" \
      {{ op }}

# Run a Terragrunt operation across the selected environment, optionally
# excluding one directory from Terragrunt's dependency-aware run queue.
tg-all env op exclude_dir="":
    #!/usr/bin/env bash
    set -euo pipefail
    if [[ -f "{{ CI_PROJECT_DIR }}/.env" ]]; then
        set -a
        source "{{ CI_PROJECT_DIR }}/.env"
        set +a
    fi
    if [[ -n "${AUTH_GITHUB_CLIENT_ID:-}" && -n "${AUTH_GITHUB_CLIENT_SECRET:-}" ]]; then
        export TF_VAR_backstage_github_client_id="${AUTH_GITHUB_CLIENT_ID}"
        export TF_VAR_backstage_github_client_secret="${AUTH_GITHUB_CLIENT_SECRET}"
    fi
    if [[ -z "${AWS_ACCOUNT_ID:-}" ]]; then
        AWS_ACCOUNT_ID="$(aws sts get-caller-identity --query Account --output text)"
        export AWS_ACCOUNT_ID
    fi
    if [[ -n "{{ exclude_dir }}" ]]; then
        terragrunt \
          --non-interactive \
          --working-dir "{{ CI_PROJECT_DIR }}/infra/live/{{ env }}" \
          run --all --queue-exclude-dir="{{ exclude_dir }}" -- {{ op }}
    else
        terragrunt \
          --non-interactive \
          --working-dir "{{ CI_PROJECT_DIR }}/infra/live/{{ env }}" \
          run --all -- {{ op }}
    fi

# Root `just push-image` delegates to this CI workflow implementation.
_push-image version:
    #!/usr/bin/env bash
    set -euo pipefail

    version="{{ version }}"
    if [[ ! "${version}" =~ ^[0-9a-f]{7,40}$ ]]; then
        echo "Version must be a 7-40 character lowercase Git hash." >&2
        exit 1
    fi

    for bin in aws terragrunt; do
        command -v "${bin}" >/dev/null 2>&1 || {
            echo "Missing required binary: ${bin}" >&2
            exit 1
        }
    done
    just --justfile "{{ CI_PROJECT_DIR }}/justfile" \
      _check-backstage-image-build push

    export AWS_ACCOUNT_ID="${AWS_ACCOUNT_ID:-$(aws sts get-caller-identity --query Account --output text)}"
    export TG_NON_INTERACTIVE=true
    ecr_stack="{{ CI_PROJECT_DIR }}/infra/live/dev/aws/ecr"
    terragrunt --working-dir "${ecr_stack}" apply -auto-approve
    repository_url="$(terragrunt --working-dir "${ecr_stack}" output -raw repository_url)"
    registry="${repository_url%%/*}"
    aws_region="$(cut -d. -f4 <<<"${registry}")"
    image_uri="${repository_url}:${version}"

    aws ecr get-login-password --region "${aws_region}" \
      | docker login --username AWS --password-stdin "${registry}"

    just --justfile "{{ CI_PROJECT_DIR }}/justfile" \
      _build-backstage-image "${image_uri}" push

    printf '\nPushed Backstage image:\n  %s\n' "${image_uri}"
    printf '%s\n' \
      '' \
      'To select this version for EC2, update:' \
      '  k8s/overlays/ec2/backstage/kustomization.yaml' \
      '' \
      'Replace its images block with the following, then commit and push it:' \
      '' \
      'images:' \
      '  - name: backstage-lab' \
      "    newName: ${repository_url}" \
      "    newTag: ${version}"
