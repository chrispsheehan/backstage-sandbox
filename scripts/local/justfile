PROJECT_DIR := source_directory() / "../.."
LAB_DIR := PROJECT_DIR / "/.lab"
CLUSTER_NAME := "platform-lab"
ARGOCD_PORT_FORWARD_LOG := LAB_DIR / "/argocd-port-forward.log"
BACKSTAGE_PORT_FORWARD_LOG := LAB_DIR / "/backstage-port-forward.log"

# Scaffold the Backstage app into backstage/. Run once, or to recreate the scaffold.
# Interactive: when prompted for a name, enter "backstage".
install:
    #!/usr/bin/env bash
    set -euo pipefail

    # node@22 is keg-only on Homebrew, so it is not linked onto PATH by default.
    if command -v brew >/dev/null 2>&1 && brew --prefix node@22 >/dev/null 2>&1; then
        export PATH="$(brew --prefix node@22)/bin:$PATH"
    fi

    cd {{ PROJECT_DIR }}
    npx @backstage/create-app@latest

# Bootstrap k3d, Argo CD, Crossplane, and the local-only integrations.
_bootstrap-cluster:
    #!/usr/bin/env bash
    set -euo pipefail

    CLUSTER_NAME="{{ CLUSTER_NAME }}" "{{ PROJECT_DIR }}/scripts/lab/bootstrap-cluster.sh"

    kubectl apply -f "{{ PROJECT_DIR }}/k8s/bootstrap/argocd/local-overrides.yaml"
    if [[ -f "{{ PROJECT_DIR }}/.env" ]]; then
        set -a
        source "{{ PROJECT_DIR }}/.env"
        set +a
    fi
    if [[ -n "${AUTH_GITHUB_CLIENT_ID:-}" && -n "${AUTH_GITHUB_CLIENT_SECRET:-}" ]]; then
        just local-argocd-github-auth
    else
        echo "AUTH_GITHUB_CLIENT_ID / AUTH_GITHUB_CLIENT_SECRET not set; skipping Argo CD GitHub SSO."
    fi
    kubectl -n argocd rollout status deployment/argocd-repo-server --timeout=300s
    kubectl -n argocd rollout status statefulset/argocd-application-controller --timeout=300s
    kubectl -n argocd rollout status deployment/argocd-dex-server --timeout=300s
    kubectl -n argocd rollout restart deployment/argocd-server
    kubectl -n argocd rollout restart deployment/argocd-dex-server
    kubectl -n argocd rollout status deployment/argocd-dex-server --timeout=300s
    kubectl -n argocd rollout status deployment/argocd-server --timeout=300s

    "{{ PROJECT_DIR }}/scripts/lab/install-crossplane-providers.sh"

    just local-ensure-argocd-port-forward

# Root `just local-up` delegates to this local workflow implementation.
_start:
    #!/usr/bin/env bash
    set -euo pipefail

    just _bootstrap-cluster
    just local-crossplane-aws-auth ~/.aws/credentials
    just local-backstage-auth
    just local-argocd-repo-auth
    just local-build-backstage-image
    just local-deploy-backstage
    just local-ensure-argocd-port-forward
    just local-ensure-backstage-port-forward

    echo "Argo CD: http://localhost:8080"
    echo "Backstage: http://localhost:7007"

# Root `just ec2-shell` delegates to this SSM workflow implementation.
_shell:
    #!/usr/bin/env bash
    set -euo pipefail

    aws_region="${AWS_REGION:-eu-west-2}"
    export AWS_ACCOUNT_ID="${AWS_ACCOUNT_ID:-$(aws sts get-caller-identity --query Account --output text)}"

    cd "{{ PROJECT_DIR }}/infra/live/dev/aws/platform_host"
    instance_id="$(terragrunt output -raw instance_id)"
    session_document_name="$(terragrunt output -raw session_document_name)"

    echo "Waiting for ${instance_id} to register with Systems Manager..."
    for _ in $(seq 1 120); do
        ping_status="$(aws ssm describe-instance-information \
          --region "${aws_region}" \
          --filters "Key=InstanceIds,Values=${instance_id}" \
          --query 'InstanceInformationList[0].PingStatus' \
          --output text 2>/dev/null || true)"

        if [[ "${ping_status}" == "Online" ]]; then
            exec aws ssm start-session \
              --region "${aws_region}" \
              --target "${instance_id}" \
              --document-name "${session_document_name}"
        fi

        sleep 5
    done

    echo "Timed out waiting for ${instance_id} to register with Systems Manager." >&2
    exit 1

# Root `just ec2-logs` delegates to this EC2 console-output follower.
_bootstrap-logs:
    #!/usr/bin/env bash
    set -euo pipefail

    for bin in aws terragrunt; do
        command -v "${bin}" >/dev/null 2>&1 || {
            echo "Missing required binary: ${bin}" >&2
            exit 1
        }
    done

    aws_region="${AWS_REGION:-eu-west-2}"
    export AWS_ACCOUNT_ID="${AWS_ACCOUNT_ID:-$(aws sts get-caller-identity --query Account --output text)}"

    cd "{{ PROJECT_DIR }}/infra/live/dev/aws/platform_host"
    instance_id="$(terragrunt output -raw instance_id)"
    console_file="$(mktemp)"
    previous_console_file="$(mktemp)"
    cleanup() {
        rm -f "${console_file}" "${previous_console_file}"
    }
    trap cleanup EXIT

    unchanged_polls=0
    echo "Following user-data console output for ${instance_id}."
    while true; do
        console_output="$(aws ec2 get-console-output \
          --region "${aws_region}" \
          --instance-id "${instance_id}" \
          --latest \
          --query Output \
          --output text 2>/dev/null || true)"

        if [[ -n "${console_output}" && "${console_output}" != "None" ]]; then
            # The AWS CLI decodes the API's base64-encoded Output field.
            printf '%s\n' "${console_output}" >"${console_file}"
            available_bytes="$(wc -c <"${console_file}" | tr -d ' ')"
            previous_bytes="$(wc -c <"${previous_console_file}" | tr -d ' ')"

            if cmp -s "${previous_console_file}" "${console_file}"; then
                unchanged_polls=$((unchanged_polls + 1))
            elif (( previous_bytes == 0 )); then
                cat "${console_file}"
                unchanged_polls=0
            elif (( available_bytes >= previous_bytes )) && \
              head -c "${previous_bytes}" "${console_file}" | cmp -s "${previous_console_file}" -; then
                tail -c "+$((previous_bytes + 1))" "${console_file}"
                unchanged_polls=0
            else
                echo "EC2 console buffer changed; showing its latest 200 lines." >&2
                tail -n 200 "${console_file}"
                unchanged_polls=0
            fi
            cp "${console_file}" "${previous_console_file}"

            if grep -q 'Platform bootstrap failed with exit code' "${console_file}"; then
                echo "EC2 user data failed; inspect the output above." >&2
                exit 1
            fi
            if grep -q 'Platform bootstrap completed.' "${console_file}"; then
                echo "EC2 user data completed successfully."
                exit 0
            fi
        else
            unchanged_polls=$((unchanged_polls + 1))
        fi

        if (( unchanged_polls >= 6 )); then
            echo "Still waiting for new EC2 console output..." >&2
            unchanged_polls=0
        fi

        sleep 5
    done

# Stop the tracked local Argo CD and Backstage port-forwards without stopping k3d.
local-stop-forwards:
    #!/usr/bin/env bash
    set -euo pipefail

    just local-stop-argocd-port-forward
    just local-stop-backstage-port-forward

# Stop the local k3d cluster without deleting it.
local-stop:
    #!/usr/bin/env bash
    set -euo pipefail

    just local-stop-forwards
    k3d cluster stop {{ CLUSTER_NAME }}

# Stop local port-forwards and remove the local Backstage image while retaining k3d.
local-clean:
    #!/usr/bin/env bash
    set -euo pipefail

    just local-stop-forwards
    docker image rm backstage-lab:dev >/dev/null 2>&1 || true

# Copy an AWS credentials file verbatim into Crossplane and apply the default cluster-wide AWS config.
local-crossplane-aws-auth credentials_file:
    #!/usr/bin/env bash
    set -euo pipefail

    for bin in kubectl cp; do
        command -v "${bin}" >/dev/null 2>&1 || {
            echo "Missing required binary: ${bin}" >&2
            exit 1
        }
    done

    credentials_file="{{ credentials_file }}"
    secret_namespace="crossplane-system"
    secret_name="aws-creds"
    aws_dir="{{ LAB_DIR }}/aws"
    creds_file="${aws_dir}/aws-creds.credentials"
    provider_config_file="{{ PROJECT_DIR }}/crossplane/providerconfigs/local/default-cluster-provider-config.yaml"

    if [[ ! -f "${credentials_file}" ]]; then
        echo "Credentials file not found: ${credentials_file}" >&2
        exit 1
    fi

    mkdir -p "${aws_dir}"
    cp "${credentials_file}" "${creds_file}"

    kubectl -n "${secret_namespace}" create secret generic "${secret_name}" \
      --from-file=creds="${creds_file}" \
      --dry-run=client \
      -o yaml | kubectl apply -f -

    kubectl apply -f "${provider_config_file}"

    echo "Updated Secret ${secret_namespace}/${secret_name} and ClusterProviderConfig/default."

# Patch the in-cluster Backstage secret from repo root .env.
local-backstage-auth:
    #!/usr/bin/env bash
    set -euo pipefail

    if [[ ! -f "{{ PROJECT_DIR }}/.env" ]]; then
        echo "Missing {{ PROJECT_DIR }}/.env" >&2
        exit 1
    fi

    cd "{{ PROJECT_DIR }}"
    set -a
    source "{{ PROJECT_DIR }}/.env"
    set +a

    : "${AUTH_GITHUB_CLIENT_ID:?AUTH_GITHUB_CLIENT_ID must be set in .env}"
    : "${AUTH_GITHUB_CLIENT_SECRET:?AUTH_GITHUB_CLIENT_SECRET must be set in .env}"

    kubectl create namespace backstage --dry-run=client -o yaml | kubectl apply -f -
    kubectl -n backstage create secret generic backstage-secrets \
      --from-literal=APP_BASE_URL="http://localhost:7007" \
      --from-literal=BACKEND_SECRET="${BACKEND_SECRET:-local-dev-backend-secret}" \
      --from-literal=AUTH_GITHUB_CLIENT_ID="${AUTH_GITHUB_CLIENT_ID}" \
      --from-literal=AUTH_GITHUB_CLIENT_SECRET="${AUTH_GITHUB_CLIENT_SECRET}" \
      --dry-run=client \
      -o yaml | kubectl apply -f -

    echo "Updated Secret backstage/backstage-secrets."

# Configure local Argo CD GitHub SSO from repo root .env.
local-argocd-github-auth:
    #!/usr/bin/env bash
    set -euo pipefail

    for bin in kubectl sed base64; do
        command -v "${bin}" >/dev/null 2>&1 || {
            echo "Missing required binary: ${bin}" >&2
            exit 1
        }
    done

    if [[ ! -f "{{ PROJECT_DIR }}/.env" ]]; then
        echo "Missing {{ PROJECT_DIR }}/.env" >&2
        exit 1
    fi

    cd "{{ PROJECT_DIR }}"
    set -a
    source "{{ PROJECT_DIR }}/.env"
    set +a

    : "${AUTH_GITHUB_CLIENT_ID:?AUTH_GITHUB_CLIENT_ID must be set in .env}"
    : "${AUTH_GITHUB_CLIENT_SECRET:?AUTH_GITHUB_CLIENT_SECRET must be set in .env}"

    rendered_dir="{{ LAB_DIR }}/argocd"
    rendered_config="${rendered_dir}/github-sso-configmap.yaml"
    template_file="{{ PROJECT_DIR }}/k8s/bootstrap/argocd/github-sso-configmap.yaml"
    encoded_secret="$(printf '%s' "${AUTH_GITHUB_CLIENT_SECRET}" | base64 | tr -d '\n')"

    mkdir -p "${rendered_dir}"

    sed \
      -e "s/__AUTH_GITHUB_CLIENT_ID__/${AUTH_GITHUB_CLIENT_ID}/g" \
      "${template_file}" > "${rendered_config}"

    kubectl apply -f "${rendered_config}"
    kubectl apply -f "{{ PROJECT_DIR }}/k8s/bootstrap/argocd/rbac-local-admin.yaml"
    kubectl -n argocd patch secret argocd-secret --type merge \
      -p "{\"data\":{\"dex.github.clientSecret\":\"${encoded_secret}\"}}"
    kubectl -n argocd rollout restart deployment/argocd-dex-server
    kubectl -n argocd rollout restart deployment/argocd-server
    kubectl -n argocd rollout status deployment/argocd-dex-server --timeout=300s
    kubectl -n argocd rollout status deployment/argocd-server --timeout=300s

    echo "Configured Argo CD GitHub SSO on http://localhost:8080 with local-lab admin RBAC."

# Configure Argo CD repository credentials for this repo.
local-argocd-repo-auth:
    #!/usr/bin/env bash
    set -euo pipefail

    repo_url="$(git remote get-url origin)"
    case "${repo_url}" in
        git@github.com:*)
            repo_https_url="https://github.com/${repo_url#git@github.com:}"
            ;;
        https://github.com/*)
            repo_https_url="${repo_url}"
            ;;
        *)
            echo "Unsupported origin remote: ${repo_url}" >&2
            exit 1
            ;;
    esac
    repo_https_url="${repo_https_url%.git}.git"
    repo_secret_name="repo-backstage-sandbox"
    github_token="$(gh auth token 2>/dev/null || true)"

    if [[ -z "${github_token}" ]]; then
        echo "No GitHub token available for Argo CD repo access. Authenticate with 'gh auth login'." >&2
        exit 1
    fi

    kubectl -n argocd create secret generic "${repo_secret_name}" \
      --from-literal=type=git \
      --from-literal=url="${repo_https_url}" \
      --from-literal=username=git \
      --from-literal=password="${github_token}" \
      --dry-run=client \
      -o yaml | kubectl label --local -f - argocd.argoproj.io/secret-type=repository -o yaml | kubectl apply -f -

    echo "Configured Argo CD repository credentials for ${repo_https_url}."

# Apply or refresh the Argo CD Backstage Application and wait for the deployment.
local-deploy-backstage:
    #!/usr/bin/env bash
    set -euo pipefail

    if [[ -f "{{ PROJECT_DIR }}/.env" ]]; then
        set -a
        source "{{ PROJECT_DIR }}/.env"
        set +a
    fi
    if [[ -n "${AUTH_GITHUB_CLIENT_ID:-}" && -n "${AUTH_GITHUB_CLIENT_SECRET:-}" ]]; then
        just local-backstage-auth
    else
        echo "AUTH_GITHUB_CLIENT_ID / AUTH_GITHUB_CLIENT_SECRET not set; keeping existing backstage/backstage-secrets values."
    fi

    repo_url="$(git remote get-url origin)"
    case "${repo_url}" in
        git@github.com:*)
            repo_https_url="https://github.com/${repo_url#git@github.com:}"
            ;;
        https://github.com/*)
            repo_https_url="${repo_url}"
            ;;
        *)
            echo "Unsupported origin remote: ${repo_url}" >&2
            exit 1
            ;;
    esac
    repo_https_url="${repo_https_url%.git}.git"
    branch_name="$(git branch --show-current)"
    if [[ -z "${branch_name}" ]]; then
        branch_name="main"
    fi

    "{{ PROJECT_DIR }}/scripts/lab/deploy-argocd-apps.sh" "${repo_https_url}" "${branch_name}"

# Build the local Backstage image and load it directly into the k3d cluster.
local-build-backstage-image:
    #!/usr/bin/env bash
    set -euo pipefail

    just --justfile "{{ PROJECT_DIR }}/justfile" \
      _build-backstage-image backstage-lab:dev local

    CLUSTER_NAME="{{ CLUSTER_NAME }}" \
      "{{ PROJECT_DIR }}/scripts/lab/load-backstage-image.sh" backstage-lab:dev

    echo "Built and loaded backstage-lab:dev into k3d."

# Start the local Argo CD port-forward unless a healthy one already exists.
local-ensure-argocd-port-forward:
    #!/usr/bin/env bash
    set -euo pipefail

    if [[ -f "{{ ARGOCD_PORT_FORWARD_LOG }}" ]] && grep -q 'error: lost connection to pod' "{{ ARGOCD_PORT_FORWARD_LOG }}"; then
        just local-stop-argocd-port-forward
    fi

    if pgrep -f 'kubectl --context k3d-platform-lab -n argocd port-forward svc/argocd-server 8080:80' >/dev/null 2>&1; then
        if curl -fsS http://localhost:8080/ >/dev/null 2>&1; then
            exit 0
        fi

        just local-stop-argocd-port-forward
    fi

    mkdir -p "{{ LAB_DIR }}"
    nohup kubectl --context k3d-platform-lab -n argocd port-forward svc/argocd-server 8080:80 >"{{ ARGOCD_PORT_FORWARD_LOG }}" 2>&1 &
    sleep 1

# Start the local Backstage port-forward unless a healthy one already exists.
local-ensure-backstage-port-forward:
    #!/usr/bin/env bash
    set -euo pipefail

    if [[ -f "{{ BACKSTAGE_PORT_FORWARD_LOG }}" ]] && grep -q 'error: lost connection to pod' "{{ BACKSTAGE_PORT_FORWARD_LOG }}"; then
        just local-stop-backstage-port-forward
    fi

    if pgrep -f 'kubectl --context k3d-platform-lab -n backstage port-forward svc/backstage 7007:7007' >/dev/null 2>&1; then
        if curl -fsS http://localhost:7007/ >/dev/null 2>&1; then
            exit 0
        fi

        just local-stop-backstage-port-forward
    fi

    mkdir -p "{{ LAB_DIR }}"
    nohup kubectl --context k3d-platform-lab -n backstage port-forward svc/backstage 7007:7007 >"{{ BACKSTAGE_PORT_FORWARD_LOG }}" 2>&1 &
    sleep 1

# Stop only the tracked local Argo CD port-forward.
local-stop-argocd-port-forward:
    #!/usr/bin/env bash
    set -euo pipefail

    pkill -f 'kubectl --context k3d-platform-lab -n argocd port-forward svc/argocd-server 8080:80' >/dev/null 2>&1 || true

# Stop only the tracked local Backstage port-forward.
local-stop-backstage-port-forward:
    #!/usr/bin/env bash
    set -euo pipefail

    pkill -f 'kubectl --context k3d-platform-lab -n backstage port-forward svc/backstage 7007:7007' >/dev/null 2>&1 || true

# Internal implementation used by the root local-down recipe.
_reset:
    #!/usr/bin/env bash
    set -euo pipefail

    just local-stop-forwards
    k3d cluster delete {{ CLUSTER_NAME }} >/dev/null 2>&1 || true
    docker image rm backstage-lab:dev >/dev/null 2>&1 || true
    rm -rf "{{ LAB_DIR }}"

    echo "Removed cluster, local lab state, and local Backstage image."
